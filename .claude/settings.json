{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs mylar:*)",
      "Bash(docker exec mylar grep:*)",
      "Bash(docker exec mylar ls:*)",
      "Bash(docker exec mylar cat /app/mylar/*)",
      "Bash(docker cp * mylar:/app/mylar/*)",
      "Bash(docker run --rm -v /share/Tarzan/Cursor/Mylar:/src:ro mylar3:local python3 -c *)"
    ],
    "ask": [
      "Bash(docker restart mylar)",
      "Bash(docker build:*)",
      "Bash(docker exec *sqlite*)",
      "Bash(docker exec *.db*)",
      "Bash(docker exec *config.ini*)",
      "Bash(docker exec * env)",
      "Bash(docker exec * printenv*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./config.ini)",
      "Read(./mylar.db)"
    ]
  }
}
